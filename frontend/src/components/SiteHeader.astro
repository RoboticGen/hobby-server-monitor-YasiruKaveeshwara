---
// Site header — the primary navigation bar for every signed-in page.
//
// It does three things: name the app, link to the routes the current visitor
// may actually visit, and show who they are with a way out. Pages render it
// once, immediately inside <body> and above their own <main>.
//
// WHY THE LINKS ARE BAKED IN BUT THE SESSION IS NOT:
// Under static output (decision 7.12 — Falcon serves the built files, there is
// no Node server in production) this frontmatter runs at BUILD time. That is
// early enough to know which route is being generated, so the "you are here"
// marker below needs no JavaScript at all — but far too early to know anything
// about the visitor, because no session cookie exists at build time. So the
// markup ships complete and the script only fills in the two things that
// depend on who is asking: the identity block, and whether the admin links
// are shown.
//
// WHY THIS IS AN .astro COMPONENT AND NOT A .tsx ISLAND:
// Elsewhere in this project components are React and pages own their styling
// via :global(...), which works because each of those components appears on
// one or two pages. A header appears on every page, so that arrangement would
// copy the same sixty lines of CSS into every page's <style> block — five
// places to keep in step. An .astro component scopes its own styles, and the
// nav is mostly plain links that have no reason to wait for React to hydrate.
import LogoutButton from "./LogoutButton";
import StatusBanner from "./StatusBanner";

interface Props {
  /**
   * Width of the header's content column, so the bar lines up with the page's
   * own `main` instead of floating at a different width. Defaults to the 60rem
   * the dashboard and users pages use; the container detail page is narrower
   * and passes its own.
   */
  maxWidth?: string;
}

const { maxWidth = "60rem" } = Astro.props;

/** One destination in the bar. */
interface NavLink {
  /** Path to link to, with no trailing slash, matched against currentPath. */
  href: string;
  label: string;
  /** Hidden until GET /api/auth/me confirms the visitor is an admin. */
  adminOnly: boolean;
}

/**
 * Nav destinations, in the order they appear.
 *
 * `adminOnly` is presentation, NOT a security control — the backend refuses
 * admin endpoints to non-admins whatever the browser shows, and hiding a link
 * protects nothing. It is here because offering someone a link to a page that
 * exists only to turn them away is a broken experience; admin/index.astro
 * already hides its create form on the same reasoning.
 *
 * /containers/view is deliberately absent: it needs a container id, so it is
 * reached from a tile, not from a fixed link. So are the throwaway test pages.
 */
const navLinks: NavLink[] = [
  { href: "/", label: "Dashboard", adminOnly: false },
  { href: "/admin", label: "Containers", adminOnly: true },
  { href: "/admin/users", label: "Users", adminOnly: true },
];

/**
 * The path of the page this header is being rendered into.
 *
 * The trailing slash is trimmed because Astro's default build format emits
 * /admin/index.html, which makes the pathname "/admin/" while the href above
 * is "/admin" — without this every link would compare unequal and no page
 * would ever look current. The regex requires a character before the slash so
 * that "/" is left alone; trimming it to "" would match nothing at all.
 */
const currentPath = Astro.url.pathname.replace(/(.)\/$/, "$1");
---

<header class="site-header">
  <!--
    The width comes in as an inline style rather than a class because it is a
    per-page value, and CSS cannot be parameterised from a prop any other way
    without generating a rule per caller.
  -->
  <div class="bar" style={`max-width: ${maxWidth}`}>
    <a class="brand" href="/">Server Monitor</a>

    <nav id="header-nav" aria-label="Main">
      <ul>
        {
          navLinks.map((link) => (
            <li hidden={link.adminOnly} data-admin-only={link.adminOnly ? "true" : null}>
              {/*
                aria-current is the marker for "this is the page you are on",
                and the stylesheet keys off the same attribute rather than a
                parallel CSS class, so what a screen reader announces and what
                is drawn can never disagree.
              */}
              <a href={link.href} aria-current={currentPath === link.href ? "page" : null}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!--
      Exactly one of the four states below is revealed once the session
      resolves. All start hidden except the pending note, so the bar never
      flashes "Sign in" at someone who is in fact signed in.
    -->
    <div class="session">
      <p id="header-pending" class="muted">Checking session…</p>

      <div id="header-identity" class="identity" hidden>
        <span id="header-email" class="email"></span>
        <span id="header-role" class="role"></span>
        <LogoutButton client:load />
      </div>

      <a id="header-signin" class="signin" href="/login" hidden>Sign in</a>

      <p id="header-unavailable" class="muted" role="status" hidden></p>
    </div>
  </div>
</header>

<!--
  Step 23.1 — Service-degradation banner (decision 7.10).

  Mounted with client:load so it begins polling GET /health immediately on
  page load. Placed after the header's closing tag so it sits directly
  below the nav bar. Because SiteHeader is rendered by every page in the
  project, this single mount point gives the banner to every page without
  per-page wiring.

  Polling logic comment (required by the build guide's comment rule):
  The banner polls GET /health every 30 seconds. That interval is
  deliberately slower than MetricTile's 10-second poll because /health
  probes LXD on every call (real daemon load), while /metrics/latest reads
  a stored sample. 30s bounds how long a stale page can lie.
-->
<StatusBanner client:load />

<script>
  import { apiFetch, ApiError } from "../lib/api";

  /**
   * The two fields of GET /api/auth/me this header uses. The endpoint also
   * returns id and status; naming only what is read keeps it clear that the
   * header does not care about the rest.
   */
  interface MeResponse {
    email: string;
    role: string;
  }

  const pending = document.getElementById("header-pending") as HTMLElement;
  const identity = document.getElementById("header-identity") as HTMLElement;
  const emailEl = document.getElementById("header-email") as HTMLElement;
  const roleEl = document.getElementById("header-role") as HTMLElement;
  const signin = document.getElementById("header-signin") as HTMLElement;
  const unavailable = document.getElementById(
    "header-unavailable",
  ) as HTMLElement;

  /** The nav items that only apply to admins, hidden in the markup above. */
  const adminItems = Array.from(
    document.querySelectorAll<HTMLElement>("#header-nav [data-admin-only]"),
  );

  try {
    const me = await apiFetch<MeResponse>("/api/auth/me");

    // textContent, never innerHTML: the email originates with a third party
    // (Google) and reaches us through the database, so treating it as markup
    // would turn the header into an injection vector on every page.
    emailEl.textContent = me.email;
    roleEl.textContent = me.role;

    if (me.role === "admin") {
      for (const item of adminItems) item.hidden = false;
    }

    pending.hidden = true;
    identity.hidden = false;
  } catch (err) {
    pending.hidden = true;

    if (err instanceof ApiError && err.status === 401) {
      // No session. The header offers the way in but does NOT redirect — the
      // page owns that decision, and each one already makes it after its own
      // /api/auth/me call. Redirecting from chrome as well would mean two
      // scripts racing to navigate, and would hijack any page that is
      // legitimately readable while signed out.
      signin.hidden = false;
    } else {
      // A 500 or an unreachable backend must not be dressed up as "signed
      // out": offering a Sign in link here would send someone to Google to
      // fix a problem that has nothing to do with their credentials. The same
      // rule the pages follow for their own error states.
      unavailable.textContent =
        err instanceof ApiError
          ? `Session unavailable (${err.status})`
          : "Session unavailable";
      unavailable.hidden = false;
    }
  }
</script>

<style>
  /* An author `display` value outranks the UA stylesheet's [hidden] rule, and
     nearly every box in this bar sets one — so without this the "hidden"
     states would all be visible at once.

     Anchored to .site-header rather than written as a bare [hidden]: Astro
     leaves a lone attribute selector unscoped, which would emit this as a
     page-wide rule and quietly change how `hidden` behaves in whichever page
     the header happens to be dropped into. The descendant form gets the scope
     attribute on .site-header, confining it to this subtree. */
  .site-header [hidden] {
    display: none !important;
  }

  /* Sticky so the nav stays reachable down a long container list. The opaque
     background is load-bearing: without it the page's content would show
     through the bar as it scrolled underneath. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #fff;
    border-bottom: 1px solid #d0d0d0;
    font-family: system-ui, sans-serif;
  }

  /* Wraps rather than scrolls or collapses into a menu button: with three
     links and one email there is nothing here that needs hiding on a narrow
     screen, and a wrapped bar has no state to get stuck in. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0 auto;
    padding: 0.6rem 1rem;
  }

  .brand {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
  }

  /* Takes the slack between the brand and the session block, which is what
     pushes the identity to the right edge without absolute positioning. */
  #header-nav {
    flex: 1;
  }

  #header-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #header-nav a {
    display: block;
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    font-size: 0.9rem;
    color: #333;
    text-decoration: none;
  }

  #header-nav a:hover {
    background: #f0f0f0;
  }

  /* Keyed off aria-current for the reason given in the markup: one source of
     truth for which page is current. */
  #header-nav a[aria-current="page"] {
    background: #222;
    color: #fff;
  }

  .session {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Long addresses break inside the word rather than widening the bar past
     the viewport. */
  .email {
    font-weight: 600;
    color: #111;
    overflow-wrap: anywhere;
  }

  .role {
    padding: 0.1rem 0.45rem;
    border: 1px solid #d0d0d0;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #555;
  }

  .signin {
    padding: 0.25rem 0.75rem;
    border: 1px solid #1a73e8;
    border-radius: 4px;
    background: #1a73e8;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }

  .muted {
    margin: 0;
    color: #555;
  }

  /* Every focusable control in the bar keeps a visible ring. The nav is the
     only way between pages, so a keyboard user who loses track of focus here
     is stranded. */
  .brand:focus-visible,
  #header-nav a:focus-visible,
  .signin:focus-visible {
    outline: 3px solid #0b3d91;
    outline-offset: 2px;
  }

  /* Reaches inside the LogoutButton island. React-rendered markup never
     receives this component's scope attribute, so these selectors have to be
     global — the same reason the pages style :global(.tile). Scoped by id so
     they cannot touch buttons elsewhere on the page. */
  :global(#header-identity button) {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }

  :global(#header-identity button:disabled) {
    color: #777;
    cursor: default;
  }

  :global(#header-identity p[role="alert"]) {
    margin: 0;
    font-size: 0.8rem;
    color: #a12;
  }

  /* Step 23.1 — StatusBanner styles.
     The component renders a <p> with className="status-banner" plus a
     second class of "degraded" or "unreachable". It returns null when
     healthy, so these rules cost nothing in the normal case. */
  :global(.status-banner) {
    margin: 0;
    padding: 0.6rem 1rem;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    text-align: center;
    font-weight: 500;
  }

  /* LXD down — stale data, mutations will 503. Amber conveys "degraded
     but partially working", distinct from the red of "everything broken". */
  :global(.status-banner.degraded) {
    background: #fff3cd;
    color: #664d03;
    border-bottom: 1px solid #ffecb5;
  }

  /* API itself unreachable — nothing on the page is live. Red because
     every figure the operator sees is frozen. */
  :global(.status-banner.unreachable) {
    background: #f8d7da;
    color: #842029;
    border-bottom: 1px solid #f5c2c7;
  }
</style>
