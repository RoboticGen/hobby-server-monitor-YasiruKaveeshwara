---
// Admin user management: everyone on the system, with their role, status and
// quota, plus the invite form. Each row opens a panel for editing that user's
// quota and granting or revoking container access.
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Users & Access · Server Monitor</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <div class="page-title-row">
        <div>
          <h1>User Access & Quotas</h1>
          <p class="subtitle">Control role authorizations, individual resource ceilings, and container assignments.</p>
        </div>
      </div>

      <div id="loading" class="skeleton-table-wrap">
        <div class="skeleton-table-header">
          <div class="skeleton-shimmer skeleton-cell" style="width: 25%;"></div>
          <div class="skeleton-shimmer skeleton-cell" style="width: 15%;"></div>
          <div class="skeleton-shimmer skeleton-cell" style="width: 15%;"></div>
          <div class="skeleton-shimmer skeleton-cell" style="width: 20%;"></div>
          <div class="skeleton-shimmer skeleton-cell" style="width: 15%;"></div>
        </div>
        {
          [1, 2, 3, 4].map(() => (
            <div class="skeleton-table-row">
              <div class="skeleton-shimmer skeleton-cell" style="width: 25%;" />
              <div class="skeleton-shimmer skeleton-cell" style="width: 12%; border-radius: 999px;" />
              <div class="skeleton-shimmer skeleton-cell" style="width: 12%; border-radius: 999px;" />
              <div class="skeleton-shimmer skeleton-cell" style="width: 20%;" />
              <div class="skeleton-shimmer skeleton-cell" style="width: 15%;" />
              <div class="skeleton-shimmer skeleton-cell" style="width: 10%; margin-left: auto;" />
            </div>
          ))
        }
      </div>

      <div id="error" class="alert alert-error" role="alert" hidden>
        <p id="error-text"></p>
        <button type="button" class="btn" onclick="location.reload()">Retry Connection</button>
      </div>

      <div class="table-container" id="table-wrapper">
        <table id="users" hidden>
          <thead>
            <tr>
              <th scope="col">User Account</th>
              <th scope="col">Role</th>
              <th scope="col">Status</th>
              <th scope="col">RAM (Used/Quota)</th>
              <th scope="col">CPU (Used/Quota)</th>
              <th scope="col">Disk (Used/Quota)</th>
              <th scope="col" style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody id="users-body"></tbody>
        </table>
      </div>

      <div id="form-mount" hidden></div>

      <!-- User Management Modal Mount Point -->
      <div id="modal-mount"></div>
    </main>

    <script>
      import { createElement } from "react";
      import { createRoot, type Root } from "react-dom/client";
      import { apiFetch, ApiError } from "../../lib/api";
      import { syncSession } from "../../lib/session";
      import InviteUserForm from "../../components/InviteUserForm";
      import UserManageModal, { type UserRecord } from "../../components/UserManageModal";

      interface Allocation {
        ram_mb: number;
        cpu: number;
        disk_gb: number;
      }

      interface UserListResponse {
        users: UserRecord[];
      }

      interface ContainerRecord {
        id: string;
        lxd_name: string;
      }

      interface ContainerListResponse {
        containers: ContainerRecord[];
      }

      const loading = document.getElementById("loading") as HTMLElement;
      const errorEl = document.getElementById("error") as HTMLElement;
      const table = document.getElementById("users") as HTMLElement;
      const tbody = document.getElementById("users-body") as HTMLElement;
      const formMount = document.getElementById("form-mount") as HTMLElement;

      const assignmentStates = new Map<string, "unknown" | "granted" | "revoked">();
      let mountedRoots: Root[] = [];
      let modalRoot: Root | null = null;
      const quotaCells = new Map<string, HTMLTableCellElement[]>();
      let latestUsers: UserRecord[] = [];
      let allContainers: ContainerRecord[] = [];

      const modalMount = document.getElementById("modal-mount") as HTMLElement;

      function fail(message: string): void {
        loading.hidden = true;
        table.hidden = true;
        (document.getElementById("error-text") as HTMLElement).textContent = message;
        errorEl.hidden = false;
      }

      function formatNumber(value: number): string {
        return String(Number(value.toFixed(2)));
      }

      function formatQuota(used: number, quota: number, unit: string): string {
        return quota === 0
          ? `${formatNumber(used)} ${unit} / ∞`
          : `${formatNumber(used)} / ${formatNumber(quota)} ${unit}`;
      }

      function closeManageModal(): void {
        if (modalRoot) {
          modalRoot.unmount();
          modalRoot = null;
        }
        modalMount.replaceChildren();
        document.body.style.overflow = "";
      }

      function openManageModal(user: UserRecord): void {
        closeManageModal();
        modalRoot = createRoot(modalMount);
        modalRoot.render(
          createElement(UserManageModal, {
            user,
            allContainers,
            assignmentStates,
            onClose: closeManageModal,
            onUserUpdated: async () => {
              await refreshUsers();
              const updated = latestUsers.find((u) => u.id === user.id);
              if (updated) openManageModal(updated);
            },
          }),
        );
        document.body.style.overflow = "hidden";
      }

      function updateQuotaCellsInPlace(user: UserRecord): void {
        const cells = quotaCells.get(user.id);
        if (!cells) return;
        cells[0].textContent = formatQuota(user.allocation.ram_mb, user.quota_ram_mb, "MB");
        cells[1].textContent = formatQuota(user.allocation.cpu, user.quota_cpu, "cores");
        cells[2].textContent = formatQuota(user.allocation.disk_gb, user.quota_disk_gb, "GB");
      }

      function renderTable(users: UserRecord[]): void {
        for (const root of mountedRoots) root.unmount();
        mountedRoots = [];
        quotaCells.clear();
        tbody.replaceChildren();

        for (const user of users) {
          const row = document.createElement("tr");
          row.dataset.status = user.status;
          row.dataset.userId = user.id;

          const emailCell = document.createElement("td");
          emailCell.className = "user-email-cell";
          emailCell.innerHTML = `
            <div class="user-cell-wrap">
              <span class="user-icon">👤</span>
              <span class="email-name">${user.email}</span>
            </div>
          `;

          const roleCell = document.createElement("td");
          roleCell.innerHTML = `<span class="role-pill ${user.role}">${user.role}</span>`;

          const statusCell = document.createElement("td");
          const normStatus = user.status.toLowerCase();
          const badgeClass = normStatus === "active" ? "running" : normStatus === "invited" ? "frozen" : "stopped";
          statusCell.innerHTML = `<span class="status-badge ${badgeClass}">${user.status}</span>`;

          const ramCell = document.createElement("td");
          ramCell.className = "mono";
          ramCell.textContent = formatQuota(user.allocation.ram_mb, user.quota_ram_mb, "MB");

          const cpuCell = document.createElement("td");
          cpuCell.className = "mono";
          cpuCell.textContent = formatQuota(user.allocation.cpu, user.quota_cpu, "cores");

          const diskCell = document.createElement("td");
          diskCell.className = "mono";
          diskCell.textContent = formatQuota(user.allocation.disk_gb, user.quota_disk_gb, "GB");

          quotaCells.set(user.id, [ramCell, cpuCell, diskCell]);

          const manageCell = document.createElement("td");
          manageCell.style.textAlign = "right";
          const manageBtn = document.createElement("button");
          manageBtn.type = "button";
          manageBtn.className = "btn btn-sm";
          manageBtn.textContent = "Manage";
          manageBtn.setAttribute("aria-haspopup", "dialog");

          manageBtn.addEventListener("click", () => {
            openManageModal(user);
          });

          manageCell.appendChild(manageBtn);

          row.append(emailCell, roleCell, statusCell, ramCell, cpuCell, diskCell, manageCell);
          tbody.appendChild(row);
        }
      }

      async function refreshUsers(): Promise<void> {
        try {
          const list = await apiFetch<UserListResponse>("/api/users");
          latestUsers = list.users;
          for (const u of list.users) updateQuotaCellsInPlace(u);
          renderTable(latestUsers);
        } catch {
          // Keep existing list on failure
        }
      }

      let initialized = false;

      async function loadAdminData(): Promise<void> {
        try {
          const [userList, containerList] = await Promise.all([
            apiFetch<UserListResponse>("/api/users"),
            apiFetch<ContainerListResponse>("/api/containers"),
          ]);

          loading.hidden = true;
          latestUsers = userList.users;
          allContainers = containerList.containers;

          table.hidden = false;
          renderTable(latestUsers);

          if (!initialized) {
            initialized = true;
            formMount.hidden = false;
            createRoot(formMount).render(
              createElement(InviteUserForm, {
                onInvited: refreshUsers,
              }),
            );
          }
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            window.location.replace("/login");
          } else if (err instanceof ApiError) {
            fail(`Could not load users (${err.status}): ${err.message}`);
          } else {
            fail("Could not reach the server to load users.");
          }
        }
      }

      void syncSession({
        onSuccess(user) {
          if (user.role !== "admin") {
            fail("This page is for administrators. Return to the dashboard.");
            return;
          }
          void loadAdminData();
        },
        onUnauthorized() {
          window.location.replace("/login");
        },
        onError(err) {
          fail("Could not reach the server to load session.");
        },
      });
    </script>

    <style>
      .page-title-row {
        margin-bottom: 2rem;
      }

      .subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-top: -1rem;
      }

      .table-container {
        margin-bottom: 3rem;
      }

      .user-cell-wrap {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }

      .user-icon {
        font-size: 1rem;
      }

      .email-name {
        font-weight: 500;
        color: var(--text-primary);
      }

      .role-pill {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        border-radius: var(--radius-full);
        font-size: 0.725rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .role-pill.admin {
        background: rgba(2, 132, 199, 0.12);
        color: var(--accent-cyan);
        border: 1px solid rgba(2, 132, 199, 0.3);
      }

      .role-pill.user {
        background: #f1f5f9;
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
      }

      .manage-row td {
        padding: 1.5rem !important;
        background: #f8fafc !important;
        border-bottom: 1px solid var(--border-medium);
      }

      .manage-panel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: 1.5rem;
      }

      .panel-box {
        padding: 1.25rem;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
      }

      .panel-box.full-width {
        grid-column: 1 / -1;
      }

      .panel-box h4 {
        margin-top: 0;
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
        color: var(--text-primary);
      }

      .assignments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: 0.75rem;
        margin-top: 1rem;
      }

      :global(.assignment-item) {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.85rem;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
      }

      :global(.assignment-item.granted) {
        border-color: rgba(16, 185, 129, 0.3);
      }

      :global(.item-info) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      :global(.container-name-text) {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-primary);
      }

      :global(.item-controls) {
        display: flex;
        gap: 0.5rem;
      }

      :global(.btn-sm) {
        padding: 0.25rem 0.65rem;
        font-size: 0.775rem;
      }

      :global(.active-grant) {
        background: rgba(16, 185, 129, 0.2) !important;
        color: #6ee7b7 !important;
        border-color: #10b981 !important;
      }

      :global(.active-revoke) {
        background: rgba(244, 63, 94, 0.2) !important;
        color: #fca5a5 !important;
        border-color: #f43f5e !important;
      }

      :global(.toggle-notice) {
        font-size: 0.725rem;
        color: var(--accent-cyan);
      }

      :global(.toggle-error) {
        font-size: 0.725rem;
        color: #f43f5e;
      }

      /* Invite User Form Styles */
      :global(.invite-form-section) {
        margin-top: 2rem;
      }

      :global(.quota-inputs-panel) {
        margin: 1.25rem 0;
        padding: 1.25rem;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
      }

      :global(.quota-inputs-panel h3) {
        margin-top: 0;
        margin-bottom: 1rem;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
      }

      :global(.quota-fields-row) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: 1rem;
      }

      /* Account & Quota Editors */
      :global(.account-editor-panel),
      :global(.quota-editor-panel) {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      :global(.account-editor-panel h4),
      :global(.quota-editor-panel h4) {
        margin: 0;
        font-size: 0.95rem;
      }

      :global(.editor-fields) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      :global(.editor-actions) {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.5rem;
      }

      :global(.quota-editor-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
        gap: 0.85rem;
      }
    </style>
  </body>
</html>
