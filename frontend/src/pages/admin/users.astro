---
// Admin user management: everyone on the system, with their role, status and
// quota, plus the invite form. Each row opens a panel for editing that user's
// quota and granting or revoking container access.
//
// WHY THE USER FETCH IS CLIENT-SIDE, NOT IN THIS FRONTMATTER:
// Same reason as index.astro and admin/index.astro. The build guide describes
// a server-rendered list from GET /api/users, but frontmatter runs at BUILD
// time under Astro's static output (decision 7.12 — Falcon serves the built
// files, there is no Node server in production). At build time there is no
// session cookie, so the call would 401 and bake a permanent error into the
// HTML. The fetch therefore runs in the browser, where the cookie exists.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Users · Server Monitor</title>
  </head>
  <body>
    <main>
      <p><a href="/admin">← Containers</a></p>
      <h1>Users</h1>

      <!-- Three exclusive states; the script unhides exactly one once the
           fetch resolves. There is deliberately no empty state: the caller
           has to be a signed-in admin to read this endpoint at all, so they
           are always in their own results and the list can never be empty. -->
      <p id="loading">Loading users…</p>
      <p id="error" role="alert" hidden></p>

      <table id="users" hidden>
        <thead>
          <tr>
            <th scope="col">Email</th>
            <th scope="col">Role</th>
            <th scope="col">Status</th>
            <th scope="col">RAM</th>
            <th scope="col">CPU</th>
            <th scope="col">Disk</th>
            <th scope="col">Manage</th>
          </tr>
        </thead>
        <tbody id="users-body"></tbody>
      </table>

      <!-- Hidden until the caller is confirmed to be an admin, so a non-admin
           never sees an invite control the API would refuse. -->
      <div id="form-mount" hidden></div>
    </main>

    <script>
      import { createElement } from "react";
      import { createRoot, type Root } from "react-dom/client";
      import { apiFetch, ApiError } from "../../lib/api";
      import InviteUserForm from "../../components/InviteUserForm";
      import UserQuotaEditor from "../../components/UserQuotaEditor";
      import AssignmentToggle, {
        type AssignmentState,
      } from "../../components/AssignmentToggle";

      /**
       * What a user's containers currently add up to, summed from the DB-cached
       * limits by compute_user_allocation(). The list endpoint attaches it to
       * every row so a quota can be shown as "used of allowed" rather than as a
       * ceiling with no context.
       */
      interface Allocation {
        ram_mb: number;
        cpu: number;
        disk_gb: number;
      }

      /** One row of GET /api/users: the users table columns plus `allocation`. */
      interface UserRecord {
        id: string;
        email: string;
        role: string;
        status: string;
        quota_ram_mb: number;
        quota_cpu: number;
        quota_disk_gb: number;
        allocation: Allocation;
      }

      interface UserListResponse {
        users: UserRecord[];
      }

      /**
       * Only the two fields the assignment toggles need. GET /api/containers
       * returns much more, but naming just these keeps it obvious that this
       * page does not care about live LXD state.
       */
      interface ContainerRecord {
        id: string;
        lxd_name: string;
      }

      interface ContainerListResponse {
        containers: ContainerRecord[];
      }

      const loading = document.getElementById("loading") as HTMLElement;
      const errorEl = document.getElementById("error") as HTMLElement;
      const table = document.getElementById("users") as HTMLElement;
      const tbody = document.getElementById("users-body") as HTMLElement;
      const formMount = document.getElementById("form-mount") as HTMLElement;

      /**
       * Everything the page has to remember between repaints.
       *
       * `assignmentStates` is the important one. No endpoint reports which
       * containers a given user holds, so the only source of that truth is the
       * answers the grant/revoke calls give back. Keeping them here — rather
       * than inside each toggle — means a repaint does not throw away what the
       * server already told us. Keys are `${userId}:${containerId}`.
       */
      const assignmentStates = new Map<string, AssignmentState>();
      /** Live React roots, so a full repaint can unmount them instead of leaking. */
      let mountedRoots: Root[] = [];
      /** The three quota cells per user id, for updating figures in place. */
      const quotaCells = new Map<string, HTMLTableCellElement[]>();
      /** Which user's manage panel is open; only one at a time. */
      let expandedUserId: string | null = null;
      /** Last data drawn, so a repaint can be triggered without re-fetching. */
      let latestUsers: UserRecord[] = [];
      let allContainers: ContainerRecord[] = [];

      /** Show a message in the error slot and hide the spinner. */
      function fail(message: string): void {
        loading.hidden = true;
        table.hidden = true;
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      /** Drop trailing zeros so a CPU quota of 2.0 reads "2" and 1.5 stays "1.5". */
      function formatNumber(value: number): string {
        return String(Number(value.toFixed(2)));
      }

      /**
       * Render one resource as "used / quota", or "used of unlimited".
       *
       * The zero case is not cosmetic. backend/lxd/quota.py skips the check
       * entirely for a resource whose quota is 0, so a bare "0" in this column
       * would tell the admin the exact opposite of what the number means —
       * "no allowance" instead of "no ceiling".
       */
      function formatQuota(used: number, quota: number, unit: string): string {
        return quota === 0
          ? `${formatNumber(used)} ${unit} / unlimited`
          : `${formatNumber(used)} / ${formatNumber(quota)} ${unit}`;
      }

      /** Composite key for `assignmentStates`. */
      function assignmentKey(userId: string, containerId: string): string {
        return `${userId}:${containerId}`;
      }

      /**
       * Build the expanded panel for one user: the quota editor, then one
       * toggle per container on the host.
       *
       * Islands are mounted imperatively because both sets depend on data that
       * only exists at runtime — Astro's `client:*` directives resolve at build
       * time, when neither the user nor the container list is known.
       */
      function renderManagePanel(user: UserRecord): HTMLTableRowElement {
        const row = document.createElement("tr");
        row.className = "manage-row";

        const cell = document.createElement("td");
        // Spans every column so the panel reads as belonging to the row above
        // rather than to one column of it.
        cell.colSpan = 7;
        row.appendChild(cell);

        const quotaHeading = document.createElement("h3");
        quotaHeading.textContent = `Quota — ${user.email}`;
        cell.appendChild(quotaHeading);

        const quotaMount = document.createElement("div");
        cell.appendChild(quotaMount);
        const quotaRoot = createRoot(quotaMount);
        mountedRoots.push(quotaRoot);
        quotaRoot.render(
          createElement(UserQuotaEditor, {
            userId: user.id,
            quotaRamMb: user.quota_ram_mb,
            quotaCpu: user.quota_cpu,
            quotaDiskGb: user.quota_disk_gb,
            allocation: user.allocation,
            onSaved: refreshUsers,
          }),
        );

        const accessHeading = document.createElement("h3");
        accessHeading.textContent = "Container access";
        cell.appendChild(accessHeading);

        if (allContainers.length === 0) {
          // Without this the heading would sit above nothing at all, which
          // reads as a failed render rather than an empty host.
          const note = document.createElement("p");
          note.className = "hint";
          note.textContent = "No containers exist yet, so there is nothing to assign.";
          cell.appendChild(note);
          return row;
        }

        const note = document.createElement("p");
        note.className = "hint";
        // Says out loud what the toggles cannot show, so "Not known" does not
        // look like a bug. Also names the soft-revoke behaviour, since
        // "Revoke" otherwise reads like it might destroy the container.
        note.textContent =
          "The API has no endpoint listing one user's containers, so access starts as \"Not known\" and is confirmed by the server on first use. Revoking frees quota and leaves the container running.";
        cell.appendChild(note);

        const list = document.createElement("ul");
        list.className = "assignments";
        cell.appendChild(list);

        for (const container of allContainers) {
          const item = document.createElement("li");
          list.appendChild(item);

          const key = assignmentKey(user.id, container.id);
          const root = createRoot(item);
          mountedRoots.push(root);
          root.render(
            createElement(AssignmentToggle, {
              userId: user.id,
              containerId: container.id,
              containerName: container.lxd_name,
              initialState: assignmentStates.get(key) ?? "unknown",
              // A real grant or revoke moves the user's allocation, so the
              // quota figures above are now stale and worth re-reading. A 409
              // or 404 moved nothing, so it only updates what we know.
              onResolved: (state: AssignmentState, changed: boolean) => {
                assignmentStates.set(key, state);
                if (changed) void refreshUsers();
              },
            }),
          );
        }

        return row;
      }

      /**
       * Draw one table row per user, plus the manage panel for whichever row is
       * open.
       *
       * Replaces the body rather than appending, so calling this again after an
       * invite does not duplicate every existing row. Any islands from the
       * previous pass are unmounted first: their DOM is about to be discarded,
       * and a root left pointing at detached nodes keeps rendering into nothing.
       */
      function renderUsers(users: UserRecord[]): void {
        for (const root of mountedRoots) root.unmount();
        mountedRoots = [];
        quotaCells.clear();
        tbody.replaceChildren();
        latestUsers = users;

        for (const user of users) {
          const row = document.createElement("tr");
          // Drives the status styling below, so "invited" reads differently
          // from "active" without keeping a second copy of the status in a
          // CSS class that could drift from the value shown in the cell.
          row.dataset.status = user.status;

          const cells = [
            user.email,
            user.role,
            // Printed verbatim rather than prettified: 'invited' / 'active' /
            // 'revoked' are the literal values the API stores, and an admin
            // reading this table is the person who will match them against a
            // curl response or the audit log.
            user.status,
            formatQuota(user.allocation.ram_mb, user.quota_ram_mb, "MB"),
            formatQuota(user.allocation.cpu, user.quota_cpu, "cores"),
            formatQuota(user.allocation.disk_gb, user.quota_disk_gb, "GB"),
          ];

          const rendered: HTMLTableCellElement[] = [];
          for (const value of cells) {
            const cell = document.createElement("td");
            // textContent, never innerHTML: the email originates with a third
            // party (Google) and passes through our database, so rendering it
            // as markup would make it an injection vector.
            cell.textContent = value;
            row.appendChild(cell);
            rendered.push(cell);
          }
          // Only the three quota cells are kept, so a refresh can rewrite the
          // figures without discarding the panel and its islands.
          quotaCells.set(user.id, rendered.slice(3));

          const manageCell = document.createElement("td");
          const manageButton = document.createElement("button");
          manageButton.type = "button";
          const open = expandedUserId === user.id;
          manageButton.textContent = open ? "Close" : "Manage";
          // aria-expanded so the button announces the panel it controls rather
          // than reading as a plain action.
          manageButton.setAttribute("aria-expanded", String(open));
          manageButton.addEventListener("click", () => {
            // One panel at a time: opening another closes this one. Two open
            // quota forms for different users invite editing the wrong row.
            expandedUserId = open ? null : user.id;
            renderUsers(latestUsers);
          });
          manageCell.appendChild(manageButton);
          row.appendChild(manageCell);

          tbody.appendChild(row);

          if (open) tbody.appendChild(renderManagePanel(user));
        }
      }

      /**
       * Rewrite the quota figures in place for users already on screen.
       *
       * Used instead of a full repaint after a quota save or an assignment
       * change, because a repaint would unmount the panel the admin is working
       * in — losing the editor's "Quota saved." confirmation and every toggle's
       * hard-won state mid-task.
       */
      function updateQuotaCells(users: UserRecord[]): void {
        latestUsers = users;

        for (const user of users) {
          const cells = quotaCells.get(user.id);
          if (!cells) continue;

          cells[0].textContent = formatQuota(user.allocation.ram_mb, user.quota_ram_mb, "MB");
          cells[1].textContent = formatQuota(user.allocation.cpu, user.quota_cpu, "cores");
          cells[2].textContent = formatQuota(user.allocation.disk_gb, user.quota_disk_gb, "GB");
        }
      }

      /**
       * Re-fetch the user list and show the new figures.
       *
       * Serves both the invite form and the manage panel, which need different
       * things: an invite adds a row, so the table has to be rebuilt, while a
       * quota save or an assignment change only moves numbers on rows that are
       * already drawn. Comparing the id sets tells the two apart, so the
       * common case leaves the open panel alone.
       */
      async function refreshUsers(): Promise<void> {
        try {
          const list = await apiFetch<UserListResponse>("/api/users");

          const drawn = new Set(quotaCells.keys());
          const sameUsers =
            list.users.length === drawn.size &&
            list.users.every((user) => drawn.has(user.id));

          if (sameUsers) updateQuotaCells(list.users);
          else renderUsers(list.users);
        } catch {
          // The change itself succeeded — only the refresh failed, and the
          // form or toggle has already reported its own success. Replacing the
          // page with an error here would contradict it.
        }
      }

      try {
        // No separate /api/auth/me call: the user list is admin-only, so its
        // own answer *is* the role check. Asking /me first would be a second
        // source of the same truth and a second round trip, and the two could
        // disagree if the caller's role changed between them.
        //
        // The container list is fetched alongside it rather than when a panel
        // opens: it is the same list for every user, so fetching it once here
        // beats re-fetching it on each expand.
        const [users, containers] = await Promise.all([
          apiFetch<UserListResponse>("/api/users"),
          apiFetch<ContainerListResponse>("/api/containers"),
        ]);

        allContainers = containers.containers;

        loading.hidden = true;
        table.hidden = false;
        renderUsers(users.users);

        formMount.hidden = false;
        // Not tracked in `mountedRoots`: the invite form outlives every table
        // repaint, so it must not be unmounted with the rows.
        createRoot(formMount).render(
          createElement(InviteUserForm, { onInvited: refreshUsers }),
        );
      } catch (err) {
        if (err instanceof ApiError && err.status === 401) {
          // No session. `replace` keeps this page out of history, so Back does
          // not return the user to a page that will bounce them again.
          window.location.replace("/login");
        } else if (err instanceof ApiError && err.status === 403) {
          // Only GET /api/users is admin-only — the container list is scoped
          // rather than refused — so a 403 here can only mean the caller is a
          // signed-in non-admin. Saying that plainly beats echoing the API's
          // wording, which does not explain that the whole page is off-limits
          // rather than one control.
          fail("This page is for administrators. Return to the dashboard.");
        } else if (err instanceof ApiError) {
          fail(`Could not load this page (${err.status}): ${err.message}`);
        } else {
          fail("Could not reach the server to load this page.");
        }
      }
    </script>

    <style>
      main {
        font-family: system-ui, sans-serif;
        max-width: 60rem;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      #error {
        color: #a12;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }

      th,
      td {
        text-align: left;
        padding: 0.45rem 0.6rem;
        border-bottom: 1px solid #e0e0e0;
      }

      th {
        font-size: 0.8rem;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      /* Quota figures line up column-wise so they can be compared by eye. The
         upper bound excludes the Manage column, which holds a button. */
      td:nth-child(n + 4):nth-child(-n + 6) {
        font-variant-numeric: tabular-nums;
      }

      td:last-child button {
        font: inherit;
        font-size: 0.85rem;
        padding: 0.2rem 0.7rem;
        cursor: pointer;
      }

      /* An invited user has not signed in yet and a revoked one can no longer
         sign in, so neither is a live account — muting both keeps the rows
         that matter visually first. */
      tr[data-status="invited"] td,
      tr[data-status="revoked"] td {
        color: #777;
      }

      /* The expanded panel is tinted and inset so it reads as detail belonging
         to the row above rather than as another user. */
      .manage-row > td {
        background: #fafafa;
        padding: 1rem 1.2rem 1.2rem;
      }

      .manage-row h3 {
        margin: 1.4rem 0 0.7rem;
        font-size: 0.95rem;
        overflow-wrap: anywhere;
      }

      .manage-row h3:first-child {
        margin-top: 0;
      }

      .manage-row .hint {
        margin: 0.6rem 0 0;
        max-width: 46rem;
        font-size: 0.8rem;
        color: #555;
      }

      .assignments {
        display: grid;
        gap: 0.5rem;
        margin: 0.7rem 0 0;
        padding: 0;
        list-style: none;
      }

      /* Component internals are styled here rather than in the .tsx files,
         matching the convention the other pages follow: components render
         plain semantic markup and carry no styles of their own. */
      :global(.quota-editor) {
        display: grid;
        grid-template-columns: auto auto 1fr;
        align-items: center;
        gap: 0.4rem 0.7rem;
        max-width: 34rem;
      }

      :global(.quota-editor label) {
        font-size: 0.85rem;
        font-weight: 600;
      }

      :global(.quota-editor input) {
        font: inherit;
        width: 7rem;
        padding: 0.3rem 0.4rem;
      }

      :global(.quota-editor .used) {
        font-size: 0.85rem;
        color: #555;
        font-variant-numeric: tabular-nums;
      }

      /* The three labelled fields own the grid columns; everything else spans
         the full width so it is not squeezed into the label column. */
      :global(.quota-editor button),
      :global(.quota-editor .hint),
      :global(.quota-editor .error),
      :global(.quota-editor .success) {
        grid-column: 1 / -1;
      }

      :global(.quota-editor button) {
        font: inherit;
        justify-self: start;
        margin-top: 0.6rem;
        padding: 0.4rem 0.9rem;
        cursor: pointer;
      }

      :global(.quota-editor .hint) {
        margin: 0;
        font-size: 0.8rem;
        color: #555;
      }

      /* Amber, not red: dropping a quota below current use is allowed and
         sometimes intended, so it is a warning rather than an error. */
      :global(.quota-editor .hint.warn) {
        color: #8a5a00;
      }

      :global(.quota-editor .error) {
        margin: 0.3rem 0 0;
        color: #a12;
        font-size: 0.9rem;
      }

      :global(.quota-editor .success) {
        margin: 0.3rem 0 0;
        color: #161;
        font-size: 0.9rem;
      }

      :global(.assignment-toggle) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
      }

      :global(.assignment-toggle .name) {
        min-width: 12rem;
        font-size: 0.9rem;
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      :global(.assignment-toggle .state) {
        min-width: 6rem;
        font-size: 0.8rem;
        color: #555;
      }

      :global(.assignment-toggle[data-state="granted"] .state) {
        color: #161;
      }

      :global(.assignment-toggle button) {
        font: inherit;
        font-size: 0.85rem;
        padding: 0.25rem 0.7rem;
        cursor: pointer;
      }

      /* Messages break onto their own line: the quota rejection is a full
         sentence of arithmetic and would otherwise stretch the row. */
      :global(.assignment-toggle .error),
      :global(.assignment-toggle .notice) {
        flex-basis: 100%;
        margin: 0;
        font-size: 0.85rem;
      }

      :global(.assignment-toggle .error) {
        color: #a12;
      }

      :global(.assignment-toggle .notice) {
        color: #161;
      }

      :global(.invite-form) {
        display: grid;
        gap: 0.35rem;
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #d0d0d0;
        max-width: 28rem;
      }

      :global(.invite-form h2) {
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
      }

      :global(.invite-form label) {
        font-size: 0.9rem;
        font-weight: 600;
        margin-top: 0.5rem;
      }

      :global(.invite-form input),
      :global(.invite-form select) {
        font: inherit;
        padding: 0.35rem 0.5rem;
      }

      :global(.invite-form button) {
        font: inherit;
        margin-top: 1rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
      }

      :global(.invite-form .hint) {
        margin: 0;
        font-size: 0.8rem;
        color: #555;
      }

      :global(.invite-form .error) {
        margin: 0.5rem 0 0;
        color: #a12;
        font-size: 0.9rem;
      }

      :global(.invite-form .success) {
        margin: 0.5rem 0 0;
        color: #161;
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
