---
// Admin dashboard: every container on the host, each with a live metric tile.
//
// WHY THE CONTAINER FETCH IS CLIENT-SIDE, NOT IN THIS FRONTMATTER:
// Same reason as index.astro. The build guide describes fetching
// GET /api/containers here at render time, but frontmatter runs at BUILD
// time under Astro's static output (decision 7.12 — Falcon serves the built
// files, there is no Node server in production). At build time there is no
// session cookie, so the call would 401 and bake a permanent error into the
// HTML. The fetch therefore runs in the browser, where the cookie exists.
import SiteHeader from "../../components/SiteHeader.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Containers · Server Monitor</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <h1>Containers</h1>

      <!-- Each of the four states below is exclusive; the script unhides
           exactly one once the fetch resolves. -->
      <p id="loading">Loading containers…</p>
      <p id="error" role="alert" hidden></p>
      <p id="empty" hidden>No containers yet, create one below.</p>
      <div id="tiles" class="tiles" hidden></div>

      <!-- Sits after the list because the empty state above points "below" to
           it. Hidden until the caller is confirmed to be an admin, so a
           non-admin never sees a create control the API would refuse. -->
      <div id="form-mount" hidden></div>
    </main>

    <script>
      import { createElement } from "react";
      import { createRoot } from "react-dom/client";
      import { apiFetch, ApiError } from "../../lib/api";
      import MetricTile from "../../components/MetricTile";
      import CreateContainerForm from "../../components/CreateContainerForm";

      /**
       * A container as returned by GET /api/containers: the DB row plus the
       * live LXD fields that _enrich_with_lxd_state() merges in.
       */
      interface ContainerRecord {
        id: string;
        lxd_name: string;
        image: string;
        limit_ram_mb: number;
        limit_cpu: number;
        limit_disk_gb: number;
        lxd_status: string;
      }

      interface ContainerListResponse {
        containers: ContainerRecord[];
      }

      /** Subset of GET /api/auth/me this page needs. */
      interface MeResponse {
        role: string;
      }

      const loading = document.getElementById("loading") as HTMLElement;
      const errorEl = document.getElementById("error") as HTMLElement;
      const empty = document.getElementById("empty") as HTMLElement;
      const tiles = document.getElementById("tiles") as HTMLElement;
      const formMount = document.getElementById("form-mount") as HTMLElement;

      /** Show a message in the error slot and hide the spinner. */
      function fail(message: string): void {
        loading.hidden = true;
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      /**
       * Draw one MetricTile island per container into the grid.
       *
       * Replaces the grid's contents rather than appending, so calling this
       * again after a create does not duplicate every existing tile.
       * Mounting is imperative because the list is only known at runtime —
       * Astro's `client:` directives resolve at build time, when the
       * container set does not exist yet.
       */
      function renderTiles(containers: ContainerRecord[]): void {
        tiles.replaceChildren();

        for (const container of containers) {
          const mount = document.createElement("div");
          tiles.appendChild(mount);

          createRoot(mount).render(
            createElement(MetricTile, {
              containerId: container.id,
              name: container.lxd_name,
              state: container.lxd_status,
              ramAllocatedMb: container.limit_ram_mb,
              diskAllocatedGb: container.limit_disk_gb,
            }),
          );
        }
      }

      /**
       * Re-fetch the container list and repaint the page.
       *
       * Passed to the form as its onCreated callback: a new container has to
       * come from the server, since only the backend knows the id and the
       * live LXD status the tile needs.
       */
      async function refreshContainers(): Promise<void> {
        try {
          const list =
            await apiFetch<ContainerListResponse>("/api/containers");

          // The empty state and the grid swap places as containers appear,
          // so both are set explicitly rather than assuming the prior state.
          empty.hidden = list.containers.length > 0;
          tiles.hidden = list.containers.length === 0;
          renderTiles(list.containers);
        } catch {
          // The container was still created — only the refresh failed. The
          // form has already reported its own success, so overwriting the
          // page with an error here would contradict it.
        }
      }

      try {
        // Both calls are independent, so they run concurrently rather than
        // making the page wait for two sequential round trips.
        const [me, list] = await Promise.all([
          apiFetch<MeResponse>("/api/auth/me"),
          apiFetch<ContainerListResponse>("/api/containers"),
        ]);

        if (me.role !== "admin") {
          // The backend already scopes GET /api/containers to what the caller
          // may see, so this is not a security control — it is honesty about
          // the page. Without it a regular user would land on a page titled
          // "Admin" showing only their own containers, implying the host has
          // just those. Their real view is the scoped dashboard.
          fail("This page is for administrators. Return to the dashboard.");
        } else {
          loading.hidden = true;

          if (list.containers.length === 0) {
            // Explicit empty state: a bare page with no tiles is ambiguous —
            // it reads as "still loading" or "something broke" rather than
            // "there is genuinely nothing here yet".
            empty.hidden = false;
          } else {
            tiles.hidden = false;
            renderTiles(list.containers);
          }

          formMount.hidden = false;
          createRoot(formMount).render(
            createElement(CreateContainerForm, {
              onCreated: refreshContainers,
            }),
          );
        }
      } catch (err) {
        // 401 means no session, so send the user to sign in. Anything else is
        // surfaced rather than redirected: bouncing to /login on a 500 or a
        // dead backend would hide the real fault behind a login screen.
        if (err instanceof ApiError && err.status === 401) {
          window.location.replace("/login");
        } else if (err instanceof ApiError) {
          fail(`Could not load containers (${err.status}): ${err.message}`);
        } else {
          fail("Could not reach the server to load containers.");
        }
      }
    </script>

    <style>
      main {
        font-family: system-ui, sans-serif;
        max-width: 60rem;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      .tiles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: 1rem;
      }

      /* Tile internals are styled here rather than in MetricTile.tsx because
         the component renders plain semantic markup and carries no styles of
         its own, so each page controls how its tiles look. */
      :global(.tile) {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        padding: 0.75rem 1rem;
      }

      :global(.tile header) {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
      }

      :global(.tile h3) {
        margin: 0;
        font-size: 1rem;
        overflow-wrap: anywhere;
      }

      :global(.tile .state) {
        font-size: 0.8rem;
        color: #555;
      }

      :global(.tile dl) {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.15rem 0.75rem;
        margin: 0.75rem 0 0;
        font-size: 0.9rem;
      }

      :global(.tile dt) {
        color: #555;
      }

      :global(.tile dd) {
        margin: 0;
        font-variant-numeric: tabular-nums;
      }

      :global(.tile .error) {
        color: #a12; /* Warning stays readable against the tile background. */
        font-size: 0.85rem;
      }

      /* Form internals are styled here for the same reason as the tile:
         CreateContainerForm renders plain semantic markup and no styles. */
      :global(.create-form) {
        display: grid;
        gap: 0.35rem;
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #d0d0d0;
        max-width: 28rem;
      }

      :global(.create-form h2) {
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
      }

      :global(.create-form label) {
        font-size: 0.9rem;
        font-weight: 600;
        margin-top: 0.5rem;
      }

      :global(.create-form input) {
        font: inherit;
        padding: 0.35rem 0.5rem;
      }

      :global(.create-form select) {
        font: inherit;
        padding: 0.35rem 0.25rem;
      }

      /* Checkbox rows read as one control: the box sits inline with its text
         rather than stacking like the labelled fields above. */
      :global(.create-form .toggle) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 400;
      }

      :global(.create-form .toggle input) {
        width: auto;
        margin: 0;
      }

      /* Range inputs ignore padding and stretch oddly with it. */
      :global(.create-form input[type="range"]) {
        padding: 0;
      }

      :global(.create-form button) {
        font: inherit;
        margin-top: 1rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
      }

      :global(.create-form .hint) {
        margin: 0;
        font-size: 0.8rem;
        color: #555;
      }

      :global(.create-form .error) {
        margin: 0.5rem 0 0;
        color: #a12;
        font-size: 0.9rem;
      }

      :global(.create-form .success) {
        margin: 0.5rem 0 0;
        color: #161;
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
