---
// Step 19.2 — Container detail page.
//
// Shows the live MetricTile (Phase 17) for the current numbers plus a
// HistoryChart of one metric series, with a 1h/24h/7d window selector that
// re-fetches GET /api/containers/{id}/history?window=... and re-renders the
// chart.
//
// WHY THE CONTAINER ID ARRIVES AS ?container=<uuid> AND NOT AS THE [id] PATH
// SEGMENT: this project builds to static output with no adapter (decision
// 7.12 — Falcon serves the built files, there is no Node server in
// production). Astro requires getStaticPaths() for every dynamic route under
// static output, and it runs at BUILD time, when no container UUIDs exist —
// so a real /containers/<uuid> page cannot be emitted. The guide's file name
// is kept exactly as specified, getStaticPaths() emits one shell at
// /containers/view/, and the shell reads the real id from the query string,
// the same pattern metric-tile-test.astro already uses. Making /containers/
// <uuid> a genuine route needs an SSR adapter — flagged in the step summary.

/**
 * Emit the single static shell this page ships as.
 *
 * The sentinel "view" is not a container id and is never matched against one;
 * it exists only because a dynamic route file must yield at least one path at
 * build time. The real id comes from ?container= at runtime.
 */
export function getStaticPaths() {
  return [{ params: { id: "view" } }];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Container detail · Server Monitor</title>
  </head>
  <body>
    <main>
      <p><a href="/">← Back to dashboard</a></p>
      <h1 id="heading">Container</h1>

      <!-- Exclusive states, like the dashboard: the script unhides whichever
           one applies once the metadata fetch resolves. -->
      <p id="loading">Loading container…</p>
      <p id="error" role="alert" hidden></p>

      <div id="detail" hidden>
        <div id="tile"></div>

        <h2>History</h2>
        <!-- Rendered server-side rather than by the script so the control is
             present in the HTML and keyboard-reachable before JS runs. -->
        <div class="windows" role="group" aria-label="History window">
          <button type="button" data-window="1h" aria-pressed="true">1h</button>
          <button type="button" data-window="24h" aria-pressed="false">24h</button>
          <button type="button" data-window="7d" aria-pressed="false">7d</button>
        </div>

        <p id="chart-status" role="status">Loading history…</p>
        <div id="chart"></div>
      </div>
    </main>

    <script>
      import { createElement } from "react";
      import { createRoot, type Root } from "react-dom/client";
      import { apiFetch, ApiError } from "../../lib/api";
      import MetricTile from "../../components/MetricTile";
      import HistoryChart from "../../components/HistoryChart";

      /**
       * GET /api/containers/{id} returns the raw DB row — unlike the list
       * endpoint, it does NOT run _enrich_with_lxd_state(), so there is no
       * lxd_status field here. Columns come straight from schema.sql.
       */
      interface ContainerRecord {
        id: string;
        lxd_name: string;
        image: string;
        limit_ram_mb: number;
        limit_cpu: number;
        limit_disk_gb: number;
        deleted_at: string | null;
      }

      /**
       * One row of GET /api/containers/{id}/history. The backend returns full
       * metric dicts at every resolution (downsampling averages each field but
       * keeps its name), so the page picks which field to plot.
       */
      interface HistoryRow {
        time: string;
        cpu_usage_ns: number;
        ram_used_mb: number;
        disk_used_mb: number;
        net_rx_bytes: number;
        net_tx_bytes: number;
        pid_count: number;
      }

      interface HistoryResponse {
        container_id: string;
        window: string;
        resolution: string;
        points: HistoryRow[];
      }

      /** The three windows the backend accepts; anything else is a 400. */
      const WINDOWS = ["1h", "24h", "7d"] as const;
      type Window = (typeof WINDOWS)[number];

      /**
       * Which metric the chart plots.
       *
       * RAM rather than CPU: HistoryChart plots stored values directly, and
       * cpu_usage_ns is a cumulative nanosecond counter, so charting it draws
       * a monotonic ramp that says nothing about load. Converting it to a
       * percentage needs consecutive-sample differencing (the arithmetic
       * MetricTile does live), which the averaged 5m/1h buckets cannot
       * support. ram_used_mb is an absolute gauge, so it is meaningful at
       * every resolution.
       */
      const CHART_FIELD: keyof HistoryRow = "ram_used_mb";

      const heading = document.getElementById("heading") as HTMLElement;
      const loading = document.getElementById("loading") as HTMLElement;
      const errorEl = document.getElementById("error") as HTMLElement;
      const detail = document.getElementById("detail") as HTMLElement;
      const tileMount = document.getElementById("tile") as HTMLElement;
      const chartMount = document.getElementById("chart") as HTMLElement;
      const chartStatus = document.getElementById(
        "chart-status",
      ) as HTMLElement;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".windows button"),
      );

      /** Show a message in the page-level error slot and stop the spinner. */
      function fail(message: string): void {
        loading.hidden = true;
        detail.hidden = true;
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      /**
       * Turn a failed request into readable copy.
       *
       * The server's own description is passed through, because for the case
       * that matters most here — requesting a container you do not own — the
       * backend answers 403 with an explicit "You do not have access to this
       * container." Replacing that with generic wording would lose the one
       * detail the reader needs.
       */
      function describe(err: unknown, subject: string): string {
        if (err instanceof ApiError) {
          return `Could not load ${subject} (${err.status}): ${err.message}`;
        }
        return `Could not reach the server to load ${subject}.`;
      }

      /**
       * The chart's React root, created once and reused.
       *
       * Calling createRoot() on the same element per window switch would
       * mount a second root over the first — React warns, and the detached
       * root keeps its state alive. Rendering into one root replaces the
       * chart's contents, which is what switching windows should do.
       */
      let chartRoot: Root | null = null;

      /**
       * Fetch one window's history and repaint the chart.
       *
       * Called on first load and on every window-button click. Each click
       * re-requests the series rather than filtering a cached one: the
       * backend serves each window from its own pre-downsampled resolution
       * (raw / 5m / 1h per decision 7.9), so the three windows are different
       * data, not slices of one series.
       */
      async function loadHistory(
        containerId: string,
        windowKey: Window,
      ): Promise<void> {
        chartStatus.hidden = false;
        chartStatus.textContent = "Loading history…";

        try {
          const history = await apiFetch<HistoryResponse>(
            `/api/containers/${encodeURIComponent(containerId)}/history?window=${windowKey}`,
          );

          if (!chartRoot) chartRoot = createRoot(chartMount);
          chartRoot.render(
            createElement(HistoryChart, {
              points: history.points.map((row) => ({
                time: row.time,
                value: Number(row[CHART_FIELD]) || 0,
              })),
            }),
          );

          // An empty series is a normal state for a container the collector
          // has not sampled through a full window yet, so it is reported as
          // fact rather than as an error.
          chartStatus.hidden = history.points.length > 0;
          chartStatus.textContent =
            history.points.length > 0
              ? ""
              : `No samples recorded in the last ${windowKey}.`;
        } catch (err) {
          // Scoped to the chart, not the page: the tile above is still live
          // and correct, so blanking the whole page over a history failure
          // would throw away working information.
          chartStatus.hidden = false;
          chartStatus.textContent = describe(err, "history");
        }
      }

      /** Wire the window buttons once the container id is known. */
      function bindWindowButtons(containerId: string): void {
        for (const button of buttons) {
          button.addEventListener("click", () => {
            const windowKey = button.dataset.window as Window;

            // aria-pressed is set on every button, not just the clicked one,
            // so the group always has exactly one pressed state.
            for (const other of buttons) {
              other.setAttribute("aria-pressed", String(other === button));
            }

            void loadHistory(containerId, windowKey);
          });
        }
      }

      const containerId = new URLSearchParams(location.search).get("container");

      if (!containerId) {
        // Explains the static-output shell rather than showing an empty page:
        // without an id there is nothing to fetch and no way to guess one.
        fail(
          "No container specified. Add ?container=<container-id> to this URL, " +
            "or open this page from the dashboard.",
        );
      } else {
        try {
          // Metadata first: the tile needs the name and the allocated figures
          // to render, and this call is also what enforces access — it answers
          // 403 for a container the caller does not own, which is the error
          // path this page has to handle cleanly.
          const container =
            await apiFetch<ContainerRecord>(
              `/api/containers/${encodeURIComponent(containerId)}`,
            );

          loading.hidden = true;
          detail.hidden = false;
          heading.textContent = container.lxd_name;
          document.title = `${container.lxd_name} · Server Monitor`;

          createRoot(tileMount).render(
            createElement(MetricTile, {
              containerId: container.id,
              name: container.lxd_name,
              // "Unknown" is the tile's documented fallback. This endpoint
              // returns the DB row without live LXD state, and the tile treats
              // the value as display text only. Raised as a question in the
              // step summary rather than worked around here.
              state: "Unknown",
              ramAllocatedMb: container.limit_ram_mb,
              diskAllocatedGb: container.limit_disk_gb,
            }),
          );

          bindWindowButtons(container.id);
          // 1h matches the aria-pressed="true" button in the markup above.
          void loadHistory(container.id, "1h");
        } catch (err) {
          // Same split as the dashboard: 401 means no session, so sign in.
          // Everything else — including the 403 this page must handle — is
          // shown, because redirecting would hide the real answer.
          if (err instanceof ApiError && err.status === 401) {
            location.replace("/login");
          } else {
            fail(describe(err, "this container"));
          }
        }
      }
    </script>

    <style>
      main {
        font-family: system-ui, sans-serif;
        max-width: 48rem;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      h1 {
        font-size: 1.4rem;
        overflow-wrap: anywhere;
      }

      h2 {
        font-size: 1.05rem;
        margin: 2rem 0 0.5rem;
      }

      #error {
        color: #a12;
      }

      .windows {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 0.75rem;
      }

      .windows button {
        font: inherit;
        padding: 0.3rem 0.8rem;
        border: 1px solid #d0d0d0;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
      }

      /* The selected window is marked by aria-pressed, so the styling hangs
         off the same attribute assistive tech reads — one source of truth for
         "which window is active" instead of a parallel CSS class. */
      .windows button[aria-pressed="true"] {
        background: #222;
        border-color: #222;
        color: #fff;
      }

      #chart-status {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        color: #555;
      }

      /* HistoryChart draws with stroke="currentColor" and ships no styles, so
         the page sets the line colour and box, exactly as the tile is styled
         on the dashboard. */
      :global(.history-chart) {
        display: block;
        width: 100%;
        color: #06c;
        border: 1px solid #e0e0e0;
      }

      /* Tile internals: MetricTile renders plain semantic markup and carries
         no styles of its own, so each page that mounts it styles it. */
      :global(.tile) {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        padding: 0.75rem 1rem;
      }

      :global(.tile header) {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
      }

      :global(.tile h3) {
        margin: 0;
        font-size: 1rem;
        overflow-wrap: anywhere;
      }

      :global(.tile .state) {
        font-size: 0.8rem;
        color: #555;
      }

      :global(.tile dl) {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.15rem 0.75rem;
        margin: 0.75rem 0 0;
        font-size: 0.9rem;
      }

      :global(.tile dt) {
        color: #555;
      }

      :global(.tile dd) {
        margin: 0;
        font-variant-numeric: tabular-nums;
      }

      :global(.tile .error) {
        color: #a12;
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
