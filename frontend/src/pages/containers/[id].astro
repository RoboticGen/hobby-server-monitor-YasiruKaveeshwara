---
// Step 19.2 — Container detail page.
//
// Shows the live MetricTile (Phase 17) for the current numbers plus a
// HistoryChart of one metric series, with a 1h/24h/7d window selector that
// re-fetches GET /api/containers/{id}/history?window=... and re-renders the
// chart.
//
// Step 22.1 also mounts the Terminal (Phase 21) here. This is the one page
// that already resolves a single container and enforces access on it, so it is
// where "look at this container" and "run something in this container" belong
// together — and it gives Terminal a route reachable by clicking a tile on
// either dashboard, rather than only by hand-typing a query string.
//
// WHY THE CONTAINER ID ARRIVES AS ?container=<uuid> AND NOT AS THE [id] PATH
// SEGMENT: this project builds to static output with no adapter (decision
// 7.12 — Falcon serves the built files, there is no Node server in
// production). Astro requires getStaticPaths() for every dynamic route under
// static output, and it runs at BUILD time, when no container UUIDs exist —
// so a real /containers/<uuid> page cannot be emitted. The guide's file name
// is kept exactly as specified, getStaticPaths() emits one shell at
// /containers/view/, and the shell reads the real id from the query string,
// the same pattern metric-tile-test.astro already uses. Making /containers/
// <uuid> a genuine route needs an SSR adapter — flagged in the step summary.

/**
 * Emit the single static shell this page ships as.
 *
 * The sentinel "view" is not a container id and is never matched against one;
 * it exists only because a dynamic route file must yield at least one path at
 * build time. The real id comes from ?container= at runtime.
 */
export function getStaticPaths() {
  return [{ params: { id: "view" } }];
}

import SiteHeader from "../../components/SiteHeader.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Container detail · Server Monitor</title>
  </head>
  <body>
    <!-- Matched to this page's narrower `main` so the bar's contents line up
         with the heading beneath it. -->
    <SiteHeader maxWidth="48rem" />

    <main>
      <!-- No back-link here: the header above carries Dashboard already. -->
      <h1 id="heading">Container</h1>

      <!-- Exclusive states, like the dashboard: the script unhides whichever
           one applies once the metadata fetch resolves. -->
      <p id="loading">Loading container…</p>
      <div id="error" role="alert" hidden>
        <p id="error-text"></p>
        <button type="button" onclick="location.reload()">Retry</button>
      </div>

      <div id="detail" hidden>
        <div id="tile"></div>

        <h2>History</h2>
        <!-- Rendered server-side rather than by the script so the control is
             present in the HTML and keyboard-reachable before JS runs. -->
        <div class="windows" role="group" aria-label="History window">
          <button type="button" data-window="1h" aria-pressed="true">1h</button>
          <button type="button" data-window="24h" aria-pressed="false">24h</button>
          <button type="button" data-window="7d" aria-pressed="false">7d</button>
        </div>

        <p id="chart-status" role="status">Loading history…</p>
        <div id="chart"></div>

        <h2>Terminal</h2>
        <!-- Mounted by the script rather than with a client: directive because
             the container id comes from the URL, which does not exist at build
             time under static output. -->
        <div id="terminal"></div>
      </div>
    </main>

    <script>
      import { createElement } from "react";
      import { createRoot, type Root } from "react-dom/client";
      import { apiFetch, ApiError } from "../../lib/api";
      import ContainerDetailSummary from "../../components/ContainerDetailSummary";
      import HistoryChart from "../../components/HistoryChart";
      import Terminal from "../../components/Terminal";

      /**
       * GET /api/containers/{id} returns the raw DB row — unlike the list
       * endpoint, it does NOT run _enrich_with_lxd_state(), so there is no
       * lxd_status field here. Columns come straight from schema.sql.
       */
      interface ContainerRecord {
        id: string;
        lxd_name: string;
        image: string;
        limit_ram_mb: number;
        limit_cpu: number;
        limit_disk_gb: number;
        deleted_at: string | null;
        lxd_status?: string;
        lxd_image?: string;
        lxd_ip_addresses?: string[];
        lxd_architecture?: string;
        lxd_created_at?: string;
      }

      /**
       * One row of GET /api/containers/{id}/history. The backend returns full
       * metric dicts at every resolution (downsampling averages each field but
       * keeps its name), so the page picks which field to plot.
       */
      interface HistoryRow {
        time: string;
        cpu_usage_ns: number;
        ram_used_mb: number;
        disk_used_mb: number;
        net_rx_bytes: number;
        net_tx_bytes: number;
        pid_count: number;
      }

      interface HistoryResponse {
        container_id: string;
        window: string;
        resolution: string;
        points: HistoryRow[];
      }

      /** The three windows the backend accepts; anything else is a 400. */
      const WINDOWS = ["1h", "24h", "7d"] as const;
      type Window = (typeof WINDOWS)[number];

      /**
       * Which metric the chart plots.
       *
       * RAM rather than CPU: HistoryChart plots stored values directly, and
       * cpu_usage_ns is a cumulative nanosecond counter, so charting it draws
       * a monotonic ramp that says nothing about load. Converting it to a
       * percentage needs consecutive-sample differencing (the arithmetic
       * MetricTile does live), which the averaged 5m/1h buckets cannot
       * support. ram_used_mb is an absolute gauge, so it is meaningful at
       * every resolution.
       */
      const CHART_FIELD: keyof HistoryRow = "ram_used_mb";

      const heading = document.getElementById("heading") as HTMLElement;
      const loading = document.getElementById("loading") as HTMLElement;
      const errorEl = document.getElementById("error") as HTMLElement;
      const detail = document.getElementById("detail") as HTMLElement;
      const tileMount = document.getElementById("tile") as HTMLElement;
      const chartMount = document.getElementById("chart") as HTMLElement;
      const terminalMount = document.getElementById("terminal") as HTMLElement;
      const chartStatus = document.getElementById(
        "chart-status",
      ) as HTMLElement;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".windows button"),
      );

      /** Show a message in the page-level error slot and stop the spinner. */
      function fail(message: string): void {
        loading.hidden = true;
        detail.hidden = true;
        (document.getElementById("error-text") as HTMLElement).textContent = message;
        errorEl.hidden = false;
      }

      /**
       * Turn a failed request into readable copy.
       *
       * The server's own description is passed through, because for the case
       * that matters most here — requesting a container you do not own — the
       * backend answers 403 with an explicit "You do not have access to this
       * container." Replacing that with generic wording would lose the one
       * detail the reader needs.
       */
      function describe(err: unknown, subject: string): string {
        if (err instanceof ApiError) {
          return `Could not load ${subject} (${err.status}): ${err.message}`;
        }
        return `Could not reach the server to load ${subject}.`;
      }

      /**
       * The chart's React root, created once and reused.
       *
       * Calling createRoot() on the same element per window switch would
       * mount a second root over the first — React warns, and the detached
       * root keeps its state alive. Rendering into one root replaces the
       * chart's contents, which is what switching windows should do.
       */
      let chartRoot: Root | null = null;

      /**
       * Fetch one window's history and repaint the chart.
       *
       * Called on first load and on every window-button click. Each click
       * re-requests the series rather than filtering a cached one: the
       * backend serves each window from its own pre-downsampled resolution
       * (raw / 5m / 1h per decision 7.9), so the three windows are different
       * data, not slices of one series.
       */
      async function loadHistory(
        containerId: string,
        windowKey: Window,
      ): Promise<void> {
        chartStatus.hidden = false;
        chartStatus.textContent = "Loading history…";

        try {
          const history = await apiFetch<HistoryResponse>(
            `/api/containers/${encodeURIComponent(containerId)}/history?window=${windowKey}`,
          );

          if (!chartRoot) chartRoot = createRoot(chartMount);
          chartRoot.render(
            createElement(HistoryChart, {
              points: history.points.map((row) => ({
                time: row.time,
                value: Number(row[CHART_FIELD]) || 0,
              })),
            }),
          );

          // An empty series is a normal state for a container the collector
          // has not sampled through a full window yet, so it is reported as
          // fact rather than as an error.
          chartStatus.hidden = history.points.length > 0;
          chartStatus.textContent =
            history.points.length > 0
              ? ""
              : `No samples recorded in the last ${windowKey}.`;
        } catch (err) {
          // Scoped to the chart, not the page: the tile above is still live
          // and correct, so blanking the whole page over a history failure
          // would throw away working information.
          chartStatus.hidden = false;
          chartStatus.textContent = describe(err, "history");
        }
      }

      /** Wire the window buttons once the container id is known. */
      function bindWindowButtons(containerId: string): void {
        for (const button of buttons) {
          button.addEventListener("click", () => {
            const windowKey = button.dataset.window as Window;

            // aria-pressed is set on every button, not just the clicked one,
            // so the group always has exactly one pressed state.
            for (const other of buttons) {
              other.setAttribute("aria-pressed", String(other === button));
            }

            void loadHistory(containerId, windowKey);
          });
        }
      }

      const containerId = new URLSearchParams(location.search).get("container");

      if (!containerId) {
        // Explains the static-output shell rather than showing an empty page:
        // without an id there is nothing to fetch and no way to guess one.
        fail(
          "No container specified. Add ?container=<container-id> to this URL, " +
            "or open this page from the dashboard.",
        );
      } else {
        try {
          // Metadata first: the detail component needs the name, allocated
          // limits, and live LXD metadata. This call is also what enforces
          // access — it answers 403 for a container the caller does not own.
          const container =
            await apiFetch<ContainerRecord>(
              `/api/containers/${encodeURIComponent(containerId)}`,
            );

          loading.hidden = true;
          detail.hidden = false;
          heading.textContent = container.lxd_name;
          document.title = `${container.lxd_name} · Server Monitor`;

          createRoot(tileMount).render(
            createElement(ContainerDetailSummary, {
              containerId: container.id,
              lxdName: container.lxd_name,
              image: container.image,
              osImage: container.lxd_image || container.image,
              ipAddresses: container.lxd_ip_addresses || [],
              architecture: container.lxd_architecture || "",
              createdAt: container.lxd_created_at || container.created_at,
              initialState: container.lxd_status || "Unknown",
              ramAllocatedMb: container.limit_ram_mb,
              cpuAllocated: container.limit_cpu,
              diskAllocatedGb: container.limit_disk_gb,
            }),
          );

          bindWindowButtons(container.id);
          // 1h matches the aria-pressed="true" button in the markup above.
          void loadHistory(container.id, "1h");

          // Mounted only after the metadata call above succeeded — and that is
          // the call that enforces access, answering 403 for a container this
          // caller was not assigned. So a command box never appears for a
          // container the caller cannot use. That is presentation, not
          // protection: the exec endpoint re-checks access on every call
          // regardless of what the page chose to render.
          createRoot(terminalMount).render(
            createElement(Terminal, { containerId: container.id }),
          );
        } catch (err) {
          // Same split as the dashboard: 401 means no session, so sign in.
          // Everything else — including the 403 this page must handle — is
          // shown, because redirecting would hide the real answer.
          if (err instanceof ApiError && err.status === 401) {
            location.replace("/login");
          } else {
            fail(describe(err, "this container"));
          }
        }
      }
    </script>

    <style>
      main {
        font-family: system-ui, sans-serif;
        max-width: 48rem;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      h1 {
        font-size: 1.4rem;
        overflow-wrap: anywhere;
      }

      h2 {
        font-size: 1.05rem;
        margin: 2rem 0 0.5rem;
      }

      #error {
        color: #a12;
      }
      #error p { margin: 0 0 0.5rem; }
      #error button {
        font: inherit;
        font-size: 0.85rem;
        padding: 0.3rem 0.9rem;
        border: 1px solid #a12;
        border-radius: 4px;
        background: #fff;
        color: #a12;
        cursor: pointer;
      }
      #error button:hover { background: #fef0f0; }

      .windows {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 0.75rem;
      }

      .windows button {
        font: inherit;
        padding: 0.3rem 0.8rem;
        border: 1px solid #d0d0d0;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
      }

      /* The selected window is marked by aria-pressed, so the styling hangs
         off the same attribute assistive tech reads — one source of truth for
         "which window is active" instead of a parallel CSS class. */
      .windows button[aria-pressed="true"] {
        background: #222;
        border-color: #222;
        color: #fff;
      }

      #chart-status {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        color: #555;
      }

      /* HistoryChart draws with stroke="currentColor" and ships no styles, so
         the page sets the line colour and box, exactly as the tile is styled
         on the dashboard. */
      :global(.history-chart) {
        display: block;
        width: 100%;
        color: #06c;
        border: 1px solid #e0e0e0;
      }

      /* Terminal internals, styled here for the same reason as the tile and the
         chart: the component renders plain semantic markup and no styles. */
      :global(.terminal-shell) {
        border: 1px solid #1f2933;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(180deg, #111827 0%, #0b1220 100%);
        color: #e5e7eb;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
      }

      :global(.terminal-bar) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
      }

      :global(.terminal-dots) {
        display: flex;
        gap: 0.35rem;
      }

      :global(.terminal-dots span) {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 999px;
        background: #64748b;
      }

      :global(.terminal-title) {
        font-family: ui-monospace, monospace;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      :global(.terminal-status) {
        margin-left: auto;
        font-size: 0.75rem;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        background: rgba(96, 165, 250, 0.15);
        color: #bfdbfe;
      }

      :global(.terminal-panel) {
        padding: 1rem;
      }

      :global(.terminal-examples) {
        padding: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        background: rgba(15, 23, 42, 0.72);
      }

      :global(.terminal-examples-header) {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: baseline;
        margin-bottom: 0.85rem;
        font-size: 0.82rem;
        color: #cbd5e1;
      }

      :global(.terminal-examples-header strong) {
        font-size: 0.9rem;
        color: #f8fafc;
      }

      :global(.terminal-examples-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 0.75rem;
      }

      :global(.terminal-example) {
        display: grid;
        gap: 0.55rem;
        padding: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 10px;
        background: rgba(17, 24, 39, 0.9);
      }

      :global(.terminal-example-copy) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      :global(.terminal-example-copy code) {
        flex: 1;
        padding: 0.45rem 0.6rem;
        border-radius: 8px;
        background: #020617;
        color: #f8fafc;
        font-family: ui-monospace, monospace;
        font-size: 0.82rem;
        overflow-wrap: anywhere;
      }

      :global(.terminal-example-copy button),
      :global(.terminal-example-run) {
        font: inherit;
        font-size: 0.8rem;
        padding: 0.35rem 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: #e5e7eb;
        cursor: pointer;
      }

      :global(.terminal-example-copy button:hover),
      :global(.terminal-example-run:hover) {
        background: rgba(255, 255, 255, 0.1);
      }

      :global(.terminal-example-meta) {
        display: grid;
        gap: 0.1rem;
        color: #cbd5e1;
      }

      :global(.terminal-example-meta span) {
        font-size: 0.8rem;
        font-weight: 700;
        color: #f8fafc;
      }

      :global(.terminal-example-meta p) {
        margin: 0;
        font-size: 0.78rem;
        line-height: 1.35;
      }

      :global(.terminal-clipboard-status) {
        min-height: 1.1rem;
        margin-top: 0.75rem;
        font-size: 0.78rem;
        color: #93c5fd;
      }

      :global(.terminal-input) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      :global(.terminal-input label) {
        font-size: 0.85rem;
        font-weight: 700;
        color: #cbd5e1;
      }

      /* The input takes the remaining width: commands are the long part of
         this row, the label and button are fixed. */
      :global(.terminal-input input) {
        flex: 1;
        font-family: ui-monospace, monospace;
        font-size: 0.9rem;
        padding: 0.55rem 0.7rem;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 10px;
        background: #020617;
        color: #f8fafc;
      }

      :global(.terminal-input input::placeholder) {
        color: #64748b;
      }

      :global(.terminal-input button) {
        font: inherit;
        padding: 0.55rem 1rem;
        border: 1px solid rgba(96, 165, 250, 0.4);
        border-radius: 10px;
        background: #2563eb;
        color: #fff;
        cursor: pointer;
      }

      :global(.terminal-input button:disabled) {
        cursor: not-allowed;
        opacity: 0.55;
      }

      :global(.terminal .hint) {
        margin: 0.7rem 0 0;
        font-size: 0.8rem;
        color: #cbd5e1;
      }

      /* The height cap is what makes this a scrolling log rather than a page
         that grows without limit, and it is what the component's auto-scroll
         to the newest entry depends on. */
      :global(.terminal-log) {
        max-height: 22rem;
        overflow-y: auto;
        margin: 0.9rem 0 0;
        padding: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        background: #020617;
        color: #e5e7eb;
        font-family: ui-monospace, monospace;
        font-size: 0.85rem;
        line-height: 1.55;
        /* Long output lines wrap instead of forcing the box to scroll
           sideways, which would hide the start of every line. */
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      /* The echoed command is the anchor for reading the transcript, so it is
         the one part that is emphasised. */
      :global(.terminal-log .prompt) {
        font-weight: 700;
        color: #93c5fd;
      }

      :global(.terminal-log .stderr) {
        color: #fca5a5;
      }

      :global(.terminal-log .exit) {
        color: #94a3b8;
      }

      /* A non-zero exit and a refused request both mean "this did not do what
         you asked", so they share one treatment. */
      :global(.terminal-log .failure) {
        color: #fda4af;
        font-weight: 700;
      }

      :global(.terminal-log:focus-visible) {
        outline: 3px solid #60a5fa;
        outline-offset: 2px;
      }

      /* Tile internals: MetricTile renders plain semantic markup and carries
         no styles of its own, so each page that mounts it styles it. */
      :global(.tile) {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        padding: 0.75rem 1rem;
      }

      :global(.tile header) {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
      }

      :global(.tile h3) {
        margin: 0;
        font-size: 1rem;
        overflow-wrap: anywhere;
      }

      :global(.tile .state) {
        font-size: 0.8rem;
        color: #555;
      }

      :global(.tile dl) {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.15rem 0.75rem;
        margin: 0.75rem 0 0;
        font-size: 0.9rem;
      }

      :global(.tile dt) {
        color: #555;
      }

      :global(.tile dd) {
        margin: 0;
        font-variant-numeric: tabular-nums;
      }

      :global(.tile .error) {
        color: #a12;
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
