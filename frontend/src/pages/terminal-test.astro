---
// THROWAWAY test page for Step 21.1, referenced by that step's test only.
// The terminal's real home is the container detail page / the scoped dashboard
// (Step 22.1, which mounts the components already built); delete this file once
// one of those exercises Terminal properly.
//
// It exists because Step 21.1 ships a component and nothing else, and its test
// says to run commands "through this UI" — which needs a page to mount into.
// Same arrangement as metric-tile-test.astro (Step 17.1) and
// history-chart-test.astro (Step 19.1).
//
// The container id comes from the query string (?container=<uuid>) so this page
// needs no fixture and no backend call of its own.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Terminal test</title>
  </head>
  <body>
    <main>
      <h1>Terminal test</h1>
      <p>
        Append <code>?container=&lt;container-uuid&gt;</code> to this URL, then
        try the quick examples to load or copy a command before running it.
      </p>
      <p>
        To check the refusal path, pass the id of a container you are
        <strong>not</strong> assigned to: the backend's 403 should appear in the
        transcript, not vanish silently.
      </p>

      <!--
        Mounted client-side because the container id comes from the URL, which
        does not exist at build time under Astro's static output.
      -->
      <div id="mount"></div>
    </main>

    <script>
      import { createElement } from "react";
      import { createRoot } from "react-dom/client";
      import Terminal from "../components/Terminal";

      const containerId = new URLSearchParams(location.search).get("container");
      const mount = document.getElementById("mount");

      if (!mount) {
        throw new Error("mount point missing");
      } else if (!containerId) {
        mount.textContent = "No ?container= id supplied.";
      } else {
        createRoot(mount).render(createElement(Terminal, { containerId }));
      }
    </script>

    <style>
      main {
        font-family: system-ui, sans-serif;
        max-width: 72rem;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      /* Terminal internals are styled here rather than in Terminal.tsx because
         the component renders plain semantic markup and carries no styles of
         its own, matching MetricTile and the forms. */
      :global(.terminal-shell) {
        border: 1px solid #1f2933;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(180deg, #111827 0%, #0b1220 100%);
        color: #e5e7eb;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
      }

      :global(.terminal-bar) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
      }

      :global(.terminal-dots) {
        display: flex;
        gap: 0.35rem;
      }

      :global(.terminal-dots span) {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 999px;
        background: #64748b;
      }

      :global(.terminal-title) {
        font-family: ui-monospace, monospace;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      :global(.terminal-status) {
        margin-left: auto;
        font-size: 0.75rem;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        background: rgba(96, 165, 250, 0.15);
        color: #bfdbfe;
      }

      :global(.terminal-panel) {
        padding: 1rem;
      }

      :global(.terminal-examples) {
        padding: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        background: rgba(15, 23, 42, 0.72);
      }

      :global(.terminal-examples-header) {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: baseline;
        margin-bottom: 0.85rem;
        font-size: 0.82rem;
        color: #cbd5e1;
      }

      :global(.terminal-examples-header strong) {
        font-size: 0.9rem;
        color: #f8fafc;
      }

      :global(.terminal-examples-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 0.75rem;
      }

      :global(.terminal-example) {
        display: grid;
        gap: 0.55rem;
        padding: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 10px;
        background: rgba(17, 24, 39, 0.9);
      }

      :global(.terminal-example-copy) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      :global(.terminal-example-copy code) {
        flex: 1;
        padding: 0.45rem 0.6rem;
        border-radius: 8px;
        background: #020617;
        color: #f8fafc;
        font-family: ui-monospace, monospace;
        font-size: 0.82rem;
        overflow-wrap: anywhere;
      }

      :global(.terminal-example-copy button),
      :global(.terminal-example-run) {
        font: inherit;
        font-size: 0.8rem;
        padding: 0.35rem 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: #e5e7eb;
        cursor: pointer;
      }

      :global(.terminal-example-copy button:hover),
      :global(.terminal-example-run:hover) {
        background: rgba(255, 255, 255, 0.1);
      }

      :global(.terminal-example-meta) {
        display: grid;
        gap: 0.1rem;
        color: #cbd5e1;
      }

      :global(.terminal-example-meta span) {
        font-size: 0.8rem;
        font-weight: 700;
        color: #f8fafc;
      }

      :global(.terminal-example-meta p) {
        margin: 0;
        font-size: 0.78rem;
        line-height: 1.35;
      }

      :global(.terminal-clipboard-status) {
        min-height: 1.1rem;
        margin-top: 0.75rem;
        font-size: 0.78rem;
        color: #93c5fd;
      }

      :global(.terminal-input) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      :global(.terminal-input label) {
        font-size: 0.85rem;
        font-weight: 700;
        color: #cbd5e1;
      }

      /* The input takes the remaining width: commands are the long part of
         this row, the label and button are fixed. */
      :global(.terminal-input input) {
        flex: 1;
        font-family: ui-monospace, monospace;
        font-size: 0.9rem;
        padding: 0.55rem 0.7rem;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 10px;
        background: #020617;
        color: #f8fafc;
      }

      :global(.terminal-input input::placeholder) {
        color: #64748b;
      }

      :global(.terminal-input button) {
        font: inherit;
        padding: 0.55rem 1rem;
        border: 1px solid rgba(96, 165, 250, 0.4);
        border-radius: 10px;
        background: #2563eb;
        color: #fff;
        cursor: pointer;
      }

      :global(.terminal-input button:disabled) {
        cursor: not-allowed;
        opacity: 0.55;
      }

      :global(.terminal .hint) {
        margin: 0.7rem 0 0;
        font-size: 0.8rem;
        color: #cbd5e1;
      }

      /* The height cap is what makes this a scrolling log rather than a page
         that grows without limit, and it is what the component's auto-scroll
         to the newest entry depends on. */
      :global(.terminal-log) {
        max-height: 22rem;
        overflow-y: auto;
        margin: 0.9rem 0 0;
        padding: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
        background: #020617;
        color: #e5e7eb;
        font-family: ui-monospace, monospace;
        font-size: 0.85rem;
        line-height: 1.55;
        /* Long output lines wrap instead of forcing the box to scroll
           sideways, which would hide the start of every line. */
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      /* The echoed command is the anchor for reading the transcript, so it is
         the one part that is emphasised. */
      :global(.terminal-log .prompt) {
        font-weight: 700;
        color: #93c5fd;
      }

      :global(.terminal-log .stderr) {
        color: #fca5a5;
      }

      :global(.terminal-log .exit) {
        color: #94a3b8;
      }

      /* A non-zero exit and a refused request both mean "this did not do what
         you asked", so they share one treatment. */
      :global(.terminal-log .failure) {
        color: #fda4af;
        font-weight: 700;
      }

      :global(.terminal-log:focus-visible) {
        outline: 3px solid #60a5fa;
        outline-offset: 2px;
      }
    </style>
  </body>
</html>
