# ============================================================================
# Hobby Server Monitor — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in real values before starting the app.
# Every variable listed here is read in exactly one place: backend/config.py.
# No other file should call os.environ directly.
# ============================================================================

# --- Google OAuth 2.0 --------------------------------------------------------
# OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# OAuth client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Callback URL registered in Google Cloud Console (must match exactly)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Authentication / Sessions -----------------------------------------------
# Signing key for JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# --- Admin Bootstrap ---------------------------------------------------------
# The one email address that becomes Admin on first sign-in.
# This prevents the "first visitor wins" race condition (see decision 7.11).
ADMIN_BOOTSTRAP_EMAIL=your-admin@gmail.com

# --- Storage -----------------------------------------------------------------
# Path to the SQLite database file
DATABASE_PATH=./data/app.db

# Path to the TinyFlux time-series data file
TINYFLUX_PATH=./data/metrics.tinyflux

# --- LXD Connection ----------------------------------------------------------
# Unix socket path or remote HTTPS endpoint for pylxd
LXD_ENDPOINT=unix:///var/snap/lxd/common/lxd/unix.socket

# Only needed if using a remote HTTPS endpoint (leave empty for unix socket)
LXD_CERT_PATH=
LXD_KEY_PATH=

# --- Collector ---------------------------------------------------------------
# Interval in seconds between metric collection cycles (default: 5)
COLLECTOR_INTERVAL_SECONDS=5

# --- Frontend / CORS ---------------------------------------------------------
# Used for CORS allowed origin and cookie domain settings
FRONTEND_ORIGIN=http://localhost:4321

# --- Session Cookies ---------------------------------------------------------
# Access token lifetime in minutes. This controls how long the JWT and its
# access_token cookie remain valid before the browser must refresh them.
ACCESS_TOKEN_LIFETIME_MINUTES=30

# Set to true in production (requires HTTPS), false for local HTTP development
SESSION_COOKIE_SECURE=false

# --- Server ------------------------------------------------------------------
# Port the Falcon API server listens on
PORT=8000
